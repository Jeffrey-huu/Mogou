{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Mogou（GUI Debug）",
      "type": "debugpy",
      "request": "launch",
      "module": "mogou",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Pytest（Mogou）",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "test/mogou",
        "-q"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
