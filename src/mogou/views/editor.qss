QMainWindow { background: #111110; color: #eeeeea; }
QMenuBar { background: #171716; color: #e8e8e4; border-bottom: 1px solid #30302e; padding: 4px 10px; }
QMenuBar::item { padding: 6px 11px; border-radius: 4px; }
QMenuBar::item:selected, QMenu::item:selected { background: #343432; }
QMenu { background: #222220; color: #ededeb; border: 1px solid #3c3c38; padding: 5px; }
QMenu::item { padding: 7px 28px 7px 10px; border-radius: 3px; }

QToolBar#editorToolbar { background: #1b1b1a; border: none; border-bottom: 1px solid #30302e; padding: 7px 12px; spacing: 3px; }
QToolButton, QPushButton { background: transparent; border: 1px solid transparent; border-radius: 5px; padding: 7px 9px; color: #dfdfdb; text-align: left; }
QToolButton:hover, QPushButton:hover { background: #343432; border-color: #494945; }
QToolButton:pressed, QPushButton:pressed { background: #555550; }

QSplitter::handle:horizontal { background: #2d2d2b; width: 4px; }
QSplitter::handle:horizontal:hover { background: #6d6d67; }
QFrame#leftSidebar, QFrame#rightSidebar { background: #191918; }
QFrame#editorPanel { background: #fdfdfb; }

QLabel#brand { color: #fafaf7; font-family: "Noto Serif CJK SC", "Source Han Serif SC", serif; font-size: 25px; font-weight: 700; padding: 0 5px; }
QLabel#sectionTitle { color: #83837e; font-size: 10px; font-weight: 700; padding: 12px 8px 5px 8px; }
QTabBar#leftTabs { background: transparent; }
QTabBar#leftTabs::tab { background: transparent; color: #92928d; border: none; border-bottom: 2px solid transparent; padding: 9px 8px; min-width: 68px; }
QTabBar#leftTabs::tab:hover { color: #e9e9e5; }
QTabBar#leftTabs::tab:selected { color: #f5f5f1; border-bottom-color: #f5f5f1; font-weight: 700; }
QStackedWidget#leftPages { background: transparent; border: none; }
QFrame#libraryEmpty { background: #20201f; border: 1px solid #343431; border-radius: 7px; }
QLabel#emptyIcon { color: #8f8f89; font-size: 26px; }
QLabel#emptyTitle { color: #e9e9e5; font-size: 13px; font-weight: 700; }
QLabel#emptyDescription { color: #777772; font-size: 11px; line-height: 1.5; }
QPushButton#collapseButton { background: #262624; border: 1px solid #3b3b38; color: #d8d8d4; font-size: 18px; padding: 0; text-align: center; }
QPushButton#collapseButton:hover { background: #f0f0ec; color: #181817; }
QPushButton#navActive { background: #eeeeea; color: #171716; font-weight: 700; }
QLabel#sideHint { color: #7d7d78; font-size: 11px; padding: 8px; }

QLabel#panelTitle { color: #fafaf7; font-size: 17px; font-weight: 700; padding: 1px 2px; }
QLabel#panelNote { color: #8e8e89; font-size: 11px; padding: 0 2px 6px 2px; }
QScrollArea#chatScroll { background: #20201f; border: 1px solid #363633; border-radius: 7px; }
QWidget#chatMessages { background: #20201f; }
QLabel#chatBubbleUser { background: #eeeeea; color: #191918; border-radius: 10px; padding: 9px 11px; }
QLabel#chatBubbleAssistant { background: #30302e; color: #efefeb; border-radius: 10px; padding: 9px 11px; }

QTextEdit { background: #fdfdfb; border: none; border-radius: 0; color: #181816; font-family: "Noto Serif CJK SC", "Source Han Serif SC", "Songti SC", serif; font-size: 18px; line-height: 1.8; selection-background-color: #b9b9ae; }
QTextEdit:focus { border: none; }
QLineEdit { background: #fbfbf8; border: 1px solid #d7d7d1; border-radius: 5px; padding: 7px 9px; color: #22221f; }
QFrame#rightSidebar QLineEdit { background: #262624; border-color: #41413e; color: #eeeeea; }
QPushButton#sendButton { background: #f1f1ed; color: #181817; font-weight: 700; text-align: center; }
QPushButton#sendButton:hover { background: #ffffff; border-color: #ffffff; }

QStatusBar { background: #171716; border-top: 1px solid #30302e; color: #92928c; }
QLineEdit#saveState, QLineEdit#stats { background: transparent; border: none; color: #92928c; padding: 0 8px; }
